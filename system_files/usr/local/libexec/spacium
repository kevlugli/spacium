#!/usr/bin/env bash
set -euo pipefail

STAMP="$HOME/.local/state/spacium.done"

[[ -f "$STAMP" ]] && exit 0

mkdir -p "$(dirname "$STAMP")"

# ==============================================================================
# Replace existing Umbriel config with image defaults
# ==============================================================================

UMBRIEL_DIR="$HOME/.config/umbriel"

if [[ -d "$UMBRIEL_DIR" ]]; then
    mv "$UMBRIEL_DIR" \
       "$HOME/.config/umbriel.pre-spacium-backup.$(date +%Y%m%d-%H%M%S)"
fi

mkdir -p "$HOME/.config"

cp -r /etc/skel/.config/umbriel \
      "$HOME/.config/"

touch "$STAMP"
