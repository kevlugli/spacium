+UMBRIEL_TEST(twoTopOutputsWithOneCenteredBelow) {
+  // Two outputs side by side on top, a third centered below both. The below
+  // output overlaps the top-right one on both axes, so it is adjacent to it
+  // vertically and horizontally at once.
+  constexpr std::array boxes{
+      OutputBox{0, 72, 1920, 1080},
+      OutputBox{1920, 0, 2048, 1152},
+      OutputBox{1111, 1152, 1536, 864},
+  };
+
+  // Top-left, cursor at its center.
+  CHECK_EQ(adjacentOutputIndex(boxes, 0, OutputDirection::Left, 960, 612), std::optional<size_t>{});
+  CHECK_EQ(adjacentOutputIndex(boxes, 0, OutputDirection::Right, 960, 612), std::optional<size_t>{1});
+  CHECK_EQ(adjacentOutputIndex(boxes, 0, OutputDirection::Up, 960, 612), std::optional<size_t>{});
+  CHECK_EQ(adjacentOutputIndex(boxes, 0, OutputDirection::Down, 960, 612), std::optional<size_t>{2});
+
+  // Top-right: Left reaches the top-left output, not the bottom one, and Down
+  // reaches the bottom output.
+  CHECK_EQ(adjacentOutputIndex(boxes, 1, OutputDirection::Left, 2944, 576), std::optional<size_t>{0});
+  CHECK_EQ(adjacentOutputIndex(boxes, 1, OutputDirection::Right, 2944, 576), std::optional<size_t>{});
+  CHECK_EQ(adjacentOutputIndex(boxes, 1, OutputDirection::Up, 2944, 576), std::optional<size_t>{});
+  CHECK_EQ(adjacentOutputIndex(boxes, 1, OutputDirection::Down, 2944, 576), std::optional<size_t>{2});
+
+  // The bottom output reaches the top-right one horizontally and the more
+  // centered top-left one vertically.
+  CHECK_EQ(adjacentOutputIndex(boxes, 2, OutputDirection::Left, 1879, 1584), std::optional<size_t>{});
+  CHECK_EQ(adjacentOutputIndex(boxes, 2, OutputDirection::Right, 1879, 1584), std::optional<size_t>{1});
+  CHECK_EQ(adjacentOutputIndex(boxes, 2, OutputDirection::Up, 1879, 1584), std::optional<size_t>{0});
+  CHECK_EQ(adjacentOutputIndex(boxes, 2, OutputDirection::Down, 1879, 1584), std::optional<size_t>{});
+}
